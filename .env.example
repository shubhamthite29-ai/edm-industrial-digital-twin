# Public frontend configuration only.
# Do not put secrets, database passwords, GitHub tokens, machine credentials,
# private IP credentials, or API keys in any VITE_* variable.

# Local development gateway. Keep localhost for your own machine only.
VITE_LIVE_WS_URL=ws://localhost:8080

# Local research ML backend.
VITE_ML_API_URL=http://localhost:8000

# A public deployment needs a real secure WebSocket gateway. Without this, the
# dashboard remains viewable but live machine commands are unavailable.
# VITE_LIVE_WS_URL=wss://your-secure-public-gateway.example.com

# Supabase Authentication & RBAC Configuration (Public frontend credentials only)
# Never place service_role key or database passwords in client environment variables!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
